services:
  youfinder:
    image: nginx:alpine
    container_name: youfinder
    restart: unless-stopped

    volumes:
      - ./html:/usr/share/nginx/html:ro

    networks:
      - web

    labels:
      - traefik.enable=true
      - traefik.http.routers.youfinder.rule=Host(`youfinder.codechaudron.fr`)
      - traefik.http.routers.youfinder.entrypoints=websecure
      - traefik.http.routers.youfinder.tls=true
      - traefik.http.routers.youfinder.tls.certresolver=myresolver
      - traefik.http.services.youfinder.loadbalancer.server.port=80
      - traefik.docker.network=web

networks:
  web:
    external: true
