services:
  postgres:
    image: postgres:16

    container_name: postgres

    restart: unless-stopped

    environment:
      POSTGRES_DB: wallabag
      POSTGRES_USER: wallabag
      POSTGRES_PASSWORD: "{{ postgres_password }}"

    volumes:
      - postgres_data:/var/lib/postgresql/data

    networks:
      - backend

volumes:
  postgres_data:
    external: true

networks:
  backend:
    external: true
