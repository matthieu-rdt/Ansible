#!/bin/bash

set -euo pipefail

export RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ restic_password_file }}"

restic backup \
    /etc \
    /opt \
    {{ postgres_backup_dir }} \
    /var/lib/docker/volumes \
    --exclude="/var/lib/docker/overlay2" \
    --verbose

curl -X POST "{{ n8n_backup_webhook_url }}" \
  -H "Content-Type: application/json" \
  -H "X-Backup-Token: {{ n8n_backup_webhook_token }}" \
  -d '{
    "status":"success",
    "service":"restic",
    "host":"vps"
  }'
