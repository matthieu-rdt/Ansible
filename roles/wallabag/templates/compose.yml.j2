services:
  wallabag:
    image: wallabag/wallabag:2.6.9

    container_name: wallabag

    restart: unless-stopped

    environment:
      SYMFONY__ENV__DATABASE_DRIVER: pdo_pgsql
      SYMFONY__ENV__DATABASE_HOST: postgres
      SYMFONY__ENV__DATABASE_PORT: "5432"
      SYMFONY__ENV__DATABASE_NAME: wallabag
      SYMFONY__ENV__DATABASE_USER: wallabag
      SYMFONY__ENV__DATABASE_PASSWORD: "{{ postgres_password }}"
      SYMFONY__ENV__DOMAIN_NAME: "https://{{ wallabag_domain }}"

    volumes:
      - wallabag_data:/var/www/wallabag/data

    networks:
      - web
      - backend

    labels:
      - traefik.enable=true
      - traefik.docker.network=web

      - traefik.http.routers.wallabag.rule=Host(`{{ wallabag_domain }}`)
      - traefik.http.routers.wallabag.entrypoints=websecure
      - traefik.http.routers.wallabag.tls=true
      - traefik.http.routers.wallabag.tls.certresolver=myresolver

      - traefik.http.services.wallabag.loadbalancer.server.port=80

volumes:
  wallabag_data:
    external: true

networks:
  web:
    external: true

  backend:
    external: true
